{
    "manifest_version": "3",
    "version": "1.0",
    "name": "Highlight Dictionary",
    "description": "When word highlighted and command + = pressed, popup definition",
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],
    "host_permissions": ["https://api.dictionaryapi.dev/*"],
    "icons": {
            "48": "images/icon-48.png",
            "96": "images/icon-96.png",
            "128": "images/icon-128.png",
            "256": "images/icon-256.png",
            "512": "images/icon-512.png"
        }
}